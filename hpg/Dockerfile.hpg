# ─────────────────────────────────────────────────────────────────────────────
# HiPerGator image.  Differs from the root Dockerfile in exactly one way that
# matters: CUDA 12.8 / PyTorch 2.9 instead of CUDA 12.4 / PyTorch 2.6.
#
# Why: HiPerGator's big GPUs are NVIDIA B200 (Blackwell, compute capability
# 10.0 / sm_100).  sm_100 did not exist when CUDA 12.4 shipped, so the CHTC
# image cannot emit code for it — a B200 job fails with
#   "no kernel image is available for execution on the device".
# CUDA 12.8 is the first toolkit with sm_100, and PyTorch 2.7 was the first
# release with cu128 wheels.  The cu128 build's arch list also still covers
# sm_75 (hpg-rtx6000) and sm_89 (L4), so ONE image serves every HPG partition.
# ─────────────────────────────────────────────────────────────────────────────
FROM pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime

RUN apt-get update && apt-get install -y \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir \
    --trusted-host pypi.org \
    --trusted-host files.pythonhosted.org \
    -r requirements.txt

COPY hpg/hpg_pipeline.py hpg/merge_shards.py ./

# No ENTRYPOINT.  `apptainer exec` supplies the command; see hpg/run_shard.sh.
